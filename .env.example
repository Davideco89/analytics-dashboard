DUCKDB_PATH=data/database/analytics.duckdb
# Use headless only when no local Metabase instance needs to be managed.
METABASE_MODE=auto

NYC_311_API_URL=https://data.cityofnewyork.us/resource/erm2-nwe9.json
NYC_311_WINDOW_DAYS=7
# Allow one additional day for the source to finish publishing requests.
NYC_311_SOURCE_LAG_DAYS=1
# Optional historical replay: set BOTH dates to naive New York local timestamps.
# NYC_311_START_DATE=2026-08-01T00:00:00
# NYC_311_END_DATE=2026-08-08T00:00:00
NYC_311_PAGE_SIZE=10000
NYC_311_MIN_ROWS=1000
NYC_311_MAX_ROWS=250000
NYC_311_RAW_PATH=data/raw/nyc_311.csv

# Optional: Socrata token for higher API rate limits
SODA_APP_TOKEN=
